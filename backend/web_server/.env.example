# Local Postgres (default when DATABASE_URL is unset)
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/siakad

# Minimum 32 characters. Required in production.
JWT_SECRET=replace-with-a-random-32-plus-character-secret

APP_ENV=development
PORT=8080

# Konfigurasi Supabase (untuk sia_backend_supabase).
# Diisi saat ingin menggunakan Supabase sebagai backend; dikosongkan → pakai Postgres mentah.
# SUPABASE_URL=https://contoh.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=ganti-dengan-kunci-service-role-min-32-karakter
